rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contributions/{contributionId} {
      // Los estudiantes autenticados solo pueden leer material aprobado/publicado
      // o sus propios aportes pendientes.
      allow read: if request.auth != null &&
        (resource.data.status == 'published' || resource.data.authorUid == request.auth.uid);
      // Cada usuario autenticado puede enviar aportes propios, siempre pendientes.
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.subject is string && request.resource.data.subject.size() <= 80 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 20000;
      // La aprobación/edición/eliminación se realiza desde Firebase Console por el administrador.
      allow update, delete: if false;
    }
  }
}
